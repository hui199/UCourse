<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginRight="12dp">

    <!-- 中框（纯色背景） -->
        <LinearLayout
            android:id="@+id/segment_gradient_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/segment_solid_orange"
            android:paddingTop="0dp" 
            android:paddingBottom="12dp" 
            android:paddingLeft="0dp"
            android:paddingRight="0dp">

        <!-- 星期几和节次信息 - 标题栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/segment_header_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:id="@+id/tv_weekday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" 
                android:includeFontPadding="false"/>
            <TextView
                android:id="@+id/tv_section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:id="@+id/tv_header_score"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="6dp"
                android:background="@drawable/score_badge"
                android:gravity="center"
                android:visibility="visible" />
        </LinearLayout>

        <!-- 课程列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_courses_in_segment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="150dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="true" />
    </LinearLayout>
</LinearLayout>