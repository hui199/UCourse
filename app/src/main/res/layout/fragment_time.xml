<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background_color">

    <!-- 移除顶部的提示文本 -->

    <com.pku.or.ucourse.view.TimeTableView
        android:id="@+id/timeTableView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_color"
        app:gridLineColor="@color/grid_line_color"
        app:gridLineWidth="1dp"
        app:timeSlotColor="@color/time_slot_color"
        app:timeSlotStrokeColor="@color/time_slot_stroke_color"
        app:timeSlotStrokeWidth="1dp"
        app:headerTextColor="@color/header_text_color"
        app:headerTextSize="14sp"
        app:sideBarTextColor="@color/side_bar_text_color"
        app:sideBarTextSize="12sp"
        app:cellWidth="45dp"
        app:cellHeight="40dp"
        app:headerHeight="40dp"
        app:sideBarWidth="60dp"
        app:morningBackgroundColor="@color/morning_background"
        app:afternoonBackgroundColor="@color/afternoon_background"
        app:eveningBackgroundColor="@color/evening_background"
        app:todayHighlightColor="@color/today_highlight_color" />



</LinearLayout>